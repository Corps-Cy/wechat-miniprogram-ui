page {
  width: 100vw;
  max-width: 100vw;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #f4f4f5;
  background-color: #09090b;
  box-sizing: border-box;
}

view, scroll-view, swiper, button, text {
  box-sizing: border-box;
}
