.demo-page {
  min-height: 100vh;
  background: #09090b;
  color: #f4f4f5;
  padding: 80rpx 36rpx 120rpx;
  box-sizing: border-box;
}

.demo-header {
  margin-bottom: 50rpx;
}

.header-badge {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  margin-bottom: 20rpx;
}

.badge-num {
  font-size: 22rpx;
  font-weight: 800;
  color: #f97316;
  margin-right: 10rpx;
}

.badge-sub {
  font-size: 20rpx;
  font-weight: 500;
  color: #a1a1aa;
}

.page-title {
  display: block;
  font-size: 60rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.page-desc {
  display: block;
  font-size: 24rpx;
  color: #71717a;
  margin-top: 14rpx;
  line-height: 1.5;
}

/* 分类 Segment 切换 */
.tab-segment-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 36rpx;
}

.tab-segment {
  display: inline-flex;
  background: #18181b;
  border: 1rpx solid #27272a;
  border-radius: 100rpx;
  padding: 8rpx;
  gap: 8rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  border-radius: 100rpx;
  transition: all 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.tab-item.active {
  background: #27272a;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.tab-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #71717a;
}

.tab-badge {
  font-size: 18rpx;
  font-weight: 800;
  padding: 2rpx 10rpx;
  border-radius: 100rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #a1a1aa;
}

.tab-item.active .tab-label {
  color: #ffffff;
}

.tab-item.active .tab-badge {
  background: rgba(249, 115, 22, 0.2);
  color: #f97316;
}

.section-container {
  margin-top: 40rpx;
}

.section-title-wrap {
  margin-bottom: 28rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #f4f4f5;
  letter-spacing: 1rpx;
}

.section-desc {
  display: block;
  font-size: 20rpx;
  color: #71717a;
  margin-top: 6rpx;
}

.demo-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.demo-card {
  background: #18181b;
  border-radius: 32rpx;
  padding: 36rpx 36rpx;
  border: 1rpx solid #27272a;
  display: flex;
  flex-direction: column;
  transition: transform 0.15s;
}

.card-hover {
  transform: scale(0.985);
  background: #202024;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.card-seq {
  font-size: 24rpx;
  font-weight: 800;
  color: #52525b;
}

.card-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #f97316;
  background: rgba(249, 115, 22, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.card-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
}

.card-sub {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 6rpx;
}

/* 动效展示块 */
.motion-block {
  margin-bottom: 40rpx;
}

.block-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #a1a1aa;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.sheet-trigger-btn {
  background: #27272a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 100rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}
