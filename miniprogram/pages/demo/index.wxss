.demo-page {
  min-height: 100vh;
  background: #f4f4f5;
  padding: 80rpx 40rpx 100rpx;
  box-sizing: border-box;
}

.demo-header {
  margin-bottom: 50rpx;
}

.header-badge {
  display: inline-flex;
  align-items: center;
  background: #18181b;
  color: #ffffff;
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  margin-bottom: 20rpx;
}

.badge-num {
  font-size: 22rpx;
  font-weight: 800;
  margin-right: 10rpx;
}

.badge-sub {
  font-size: 20rpx;
  font-weight: 500;
  color: #d4d4d8;
}

.page-title {
  display: block;
  font-size: 56rpx;
  font-weight: 900;
  color: #09090b;
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.page-desc {
  display: block;
  font-size: 24rpx;
  color: #71717a;
  margin-top: 14rpx;
  line-height: 1.5;
}

.demo-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.demo-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx 36rpx;
  border: 1rpx solid #e4e4e7;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  transition: transform 0.15s, box-shadow 0.15s;
}

.card-hover {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.card-seq {
  font-size: 24rpx;
  font-weight: 800;
  color: #a1a1aa;
}

.card-pill {
  font-size: 18rpx;
  font-weight: 700;
  color: #52525b;
  background: #f4f4f5;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  letter-spacing: 0.5rpx;
}

.card-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #18181b;
}

.card-sub {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 6rpx;
}
