<view class="demo-page">
  <!-- 顶部分类导航 -->
  <view class="demo-header">
    <view class="header-badge">
      <text class="badge-num">24</text>
      <text class="badge-sub">微信小程序 · 精品交互与高阶质感库</text>
    </view>
    <text class="page-title">Vibe Coding UI</text>
    <text class="page-desc">物理流体曲线 · 3D 光影质感 · WXS 丝滑手势交互 · 高级提示动效</text>

    <!-- 分类 Segment 切换 -->
    <scroll-view class="tab-segment-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="tab-segment">
        <view 
          class="tab-item {{currentTab === 'popups' ? 'active' : ''}}" 
          bindtap="switchTab" 
          data-tab="popups"
        >
          <text class="tab-label">01 凭证弹窗</text>
          <text class="tab-badge">6款</text>
        </view>
        <view 
          class="tab-item {{currentTab === 'motions' ? 'active' : ''}}" 
          bindtap="switchTab" 
          data-tab="motions"
        >
          <text class="tab-label">02 质感微动效</text>
          <text class="tab-badge">8款</text>
        </view>
        <view 
          class="tab-item {{currentTab === 'layouts' ? 'active' : ''}}" 
          bindtap="switchTab" 
          data-tab="layouts"
        >
          <text class="tab-label">03 审美页面布局</text>
          <text class="tab-badge">4款</text>
        </view>
        <view 
          class="tab-item {{currentTab === 'interactions' ? 'active' : ''}}" 
          bindtap="switchTab" 
          data-tab="interactions"
        >
          <text class="tab-label">04 触觉高级交互</text>
          <text class="tab-badge">6款</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ==================== 分类 1：凭证与卡券类弹层 ==================== -->
  <view class="section-container" wx:if="{{currentTab === 'popups'}}">
    <view class="section-title-wrap">
      <text class="section-title">凭证与权益弹层 · POPUP PANELS</text>
      <text class="section-desc">告别生硬白框，层次感与沉浸感拉满的 6 种弹层</text>
    </view>

    <view class="demo-grid">
      <view class="demo-card" hover-class="card-hover" bindtap="openModal" data-type="frosted">
        <view class="card-meta">
          <text class="card-seq">01</text>
          <view class="card-pill">BLUR 26px · FILL .42 · 4f</view>
        </view>
        <text class="card-name">玻璃面板浮起</text>
        <text class="card-sub">Frosted Glass Sheet · 12 月份格子错帧填充</text>
      </view>

      <view class="demo-card" hover-class="card-hover" bindtap="openModal" data-type="ring">
        <view class="card-meta">
          <text class="card-seq">02</text>
          <view class="card-pill">SCRM 40% · RING 1.2s</view>
        </view>
        <text class="card-name">圆环计数弹出</text>
        <text class="card-sub">Ring Count Sheet · 顺时针画圆与数字同步递增</text>
      </view>

      <view class="demo-card" hover-class="card-hover" bindtap="openModal" data-type="ruler">
        <view class="card-meta">
          <text class="card-seq">03</text>
          <view class="card-pill">TICKS 53 · 1f · INLINE</view>
        </view>
        <text class="card-name">刻度扫到今天</text>
        <text class="card-sub">Tick Ruler Sheet · 53周刻度点亮 + 行内字号平滑展开</text>
      </view>

      <view class="demo-card" hover-class="card-hover" bindtap="openModal" data-type="photo">
        <view class="card-meta">
          <text class="card-seq">04</text>
          <view class="card-pill">IMG 1.08→1 · MT -22px</view>
        </view>
        <text class="card-name">照片抽屉贴合</text>
        <text class="card-sub">Photo Drawer Sheet · 暗角大字 + 负外边距无缝卡位</text>
      </view>

      <view class="demo-card" hover-class="card-hover" bindtap="openModal" data-type="flip">
        <view class="card-meta">
          <text class="card-seq">05</text>
          <view class="card-pill">PERSP 1200 · Y180 · BACK</view>
        </view>
        <text class="card-name">原地翻面面板</text>
        <text class="card-sub">Flip Card Sheet · 3D 立体翻转 + 背面暗色防伪核销</text>
      </view>

      <view class="demo-card" hover-class="card-hover" bindtap="openModal" data-type="drag">
        <view class="card-meta">
          <text class="card-seq">06</text>
          <view class="card-pill">SPRING DAMP · DRAG</view>
        </view>
        <text class="card-name">下拉展开抽屉</text>
        <text class="card-sub">Drag Expand Sheet · 拖动手柄阻尼展开细节</text>
      </view>
    </view>
  </view>

  <!-- ==================== 分类 2：质感微动效 ==================== -->
  <view class="section-container" wx:if="{{currentTab === 'motions'}}">
    <view class="section-title-wrap">
      <text class="section-title">质感微动效 · TACTILE MOTIONS</text>
      <text class="section-desc">8 种高质感光影与物理弹性反馈组件</text>
    </view>

    <!-- 01 陀螺仪 3D 倾斜光影卡片 -->
    <view class="motion-block">
      <text class="block-label">01 3D 倾斜光影卡片 (TILT GLARE)</text>
      <tilt-glare-card />
    </view>

    <!-- 02 动态弥散锥形光晕 -->
    <view class="motion-block">
      <text class="block-label">02 动态弥散光晕卡片 (CONIC GLOW)</text>
      <conic-glow-card />
    </view>

    <!-- 03 磁吸游标与滚动码表 -->
    <view class="motion-block">
      <text class="block-label">03 磁吸游标与滚动码表 (ODOMETER CHART)</text>
      <odometer-chart />
    </view>

    <!-- 04 流体胶囊形变面板 -->
    <view class="motion-block">
      <text class="block-label">04 流体胶囊形变面板 (FLUID MORPH)</text>
      <fluid-morph-sheet />
    </view>

    <!-- 05 共享元素无缝展开卡片 -->
    <view class="motion-block">
      <text class="block-label">05 共享元素卡片展开 (SHARED ELEMENT)</text>
      <shared-element-card />
    </view>

    <!-- 06 三段阻尼弹性抽屉 -->
    <view class="motion-block">
      <text class="block-label">06 三段阻尼弹性抽屉 (ELASTIC SHEET)</text>
      <button class="sheet-trigger-btn" bindtap="openElasticSheet">打开三段阻尼抽屉</button>
    </view>

    <!-- 07 物理弹簧交错流 (带重播与点击反馈) -->
    <view class="motion-block">
      <text class="block-label">07 物理弹簧交错流 (STAGGER CASCADE)</text>
      <stagger-cascade-grid />
    </view>

    <!-- 08 弹性微缩触觉反馈按键 -->
    <view class="motion-block">
      <text class="block-label">08 弹性微缩触觉反馈 (PRESS SCALE)</text>
      <press-scale-button />
    </view>
  </view>

  <!-- ==================== 分类 3：审美页面布局 ==================== -->
  <view class="section-container" wx:if="{{currentTab === 'layouts'}}">
    <view class="section-title-wrap">
      <text class="section-title">高级审美页面布局 · AESTHETIC LAYOUTS</text>
      <text class="section-desc">源自前沿 App 视觉语言，打破模板化平铺陈列</text>
    </view>

    <!-- 便当盒网格墙 BENTO GRID -->
    <view class="motion-block">
      <text class="block-label">01 便当盒网格墙 (BENTO GRID WALL)</text>
      <bento-grid-wall />
    </view>

    <!-- 层叠卡片牌组 STACKED DECK -->
    <view class="motion-block">
      <text class="block-label">02 层叠卡片牌组 (STACKED DECK)</text>
      <stacked-deck-view />
    </view>

    <!-- 分层视差抽离面板 LAYERED EXPLODED -->
    <view class="motion-block">
      <text class="block-label">03 分层视差抽离面板 (LAYERED EXPLODED)</text>
      <layered-exploded-panel />
    </view>

    <!-- 高级排版：重叠咬合与阶梯错位 OVERLAP & STAGGER -->
    <view class="motion-block">
      <text class="block-label">04 重叠咬合与阶梯错位排版 (OVERLAP & STAGGER)</text>
      <overlap-stagger-card />
    </view>
  </view>

  <!-- ==================== 分类 4：触觉高级交互 ==================== -->
  <view class="section-container" wx:if="{{currentTab === 'interactions'}}">
    <view class="section-title-wrap">
      <text class="section-title">触觉高级交互 · ADVANCED INTERACTIONS</text>
      <text class="section-desc">手一碰就有回应，基于 WXS 60fps 手势、提示动效与流体形变</text>
    </view>

    <!-- 左右滑动卡片堆叠 SWIPE CARD STACK -->
    <view class="motion-block">
      <text class="block-label">01 左右滑动卡片堆叠 (SWIPE STACK)</text>
      <swipe-card-stack />
    </view>

    <!-- 裂变流体胶囊按键 SPLIT BUTTON MORPH -->
    <view class="motion-block">
      <text class="block-label">02 裂变流体胶囊按键 (SPLIT BUTTON)</text>
      <split-button-morph />
    </view>

    <!-- 滚动联动分类列表 SCROLL SPY CATEGORY -->
    <view class="motion-block">
      <text class="block-label">03 滚动联动分类列表 (SCROLL SPY)</text>
      <scroll-spy-category />
    </view>

    <!-- 倒计时进度撤销条 UNDO TIMER BAR -->
    <view class="motion-block">
      <text class="block-label">04 倒计时进度撤销条 (UNDO TIMER BAR)</text>
      <undo-timer-bar />
    </view>

    <!-- 红点原位弧线收回与三层联动消散 DOT REBOUND SCATTER -->
    <view class="motion-block">
      <text class="block-label">05 红点弧线回缩与三级联动消散 (DOT REBOUND)</text>
      <dot-rebound-scatter />
    </view>

    <!-- 状态形变图标与动作即反馈 STATE MORPH ICON -->
    <view class="motion-block">
      <text class="block-label">06 状态形变图标与动作即反馈 (STATE MORPH ICON)</text>
      <state-morph-icon />
    </view>
  </view>

  <!-- ==================== 弹层组件实体挂载 ==================== -->
  <frosted-glass-sheet 
    visible="{{activeModal === 'frosted'}}" 
    bind:close="closeModal" 
  />

  <ring-count-sheet 
    visible="{{activeModal === 'ring'}}" 
    bind:close="closeModal" 
  />

  <tick-ruler-sheet 
    visible="{{activeModal === 'ruler'}}" 
    bind:close="closeModal" 
  />

  <photo-drawer-sheet 
    visible="{{activeModal === 'photo'}}" 
    bind:close="closeModal" 
  />

  <flip-card-sheet 
    visible="{{activeModal === 'flip'}}" 
    bind:close="closeModal" 
  />

  <drag-expand-sheet 
    visible="{{activeModal === 'drag'}}" 
    bind:close="closeModal" 
  />

  <!-- 弹性抽屉实例 -->
  <elastic-bottom-sheet 
    visible="{{elasticSheetVisible}}" 
    bind:close="closeElasticSheet" 
  />
</view>
