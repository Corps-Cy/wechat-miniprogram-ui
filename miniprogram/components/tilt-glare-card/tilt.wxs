var startX = 0;
var startY = 0;

function touchStart(e, ins) {
  var touch = e.touches[0] || e.changedTouches[0];
  startX = touch.clientX;
  startY = touch.clientY;

  var glare = ins.selectComponent('.glare-layer');
  if (glare) {
    glare.setStyle({
      'opacity': '1'
    });
  }
  var card = ins.selectComponent('.tilt-body');
  if (card) {
    card.setStyle({
      'transition': 'none'
    });
  }
}

function touchMove(e, ins) {
  var touch = e.touches[0] || e.changedTouches[0];
  var card = ins.selectComponent('.tilt-body');
  if (!card) return;

  var deltaX = touch.clientX - startX;
  var deltaY = touch.clientY - startY;

  // 限制最大旋转角度 ±8deg (相对位移计算，适配任意滚动位置)
  var rx = -(deltaY / 60) * 8;
  var ry = (deltaX / 60) * 8;
  rx = Math.max(Math.min(rx, 8), -8);
  ry = Math.max(Math.min(ry, 8), -8);

  card.setStyle({
    'transform': 'perspective(800px) rotateX(' + rx.toFixed(1) + 'deg) rotateY(' + ry.toFixed(1) + 'deg) scale3d(1.02, 1.02, 1.02)'
  });

  // 更新镜面反光流光位置
  var glareX = 50 + (ry / 8) * 45;
  var glareY = 50 - (rx / 8) * 45;
  var glare = ins.selectComponent('.glare-layer');
  if (glare) {
    glare.setStyle({
      'background': 'radial-gradient(circle at ' + glareX.toFixed(0) + '% ' + glareY.toFixed(0) + '%, rgba(255,255,255,0.45) 0%, rgba(255,255,255,0) 65%)',
      'opacity': '1'
    });
  }

  ins.callMethod('onTiltUpdate', {
    tiltX: rx.toFixed(1),
    tiltY: ry.toFixed(1),
    glare: 100
  });
}

function touchEnd(e, ins) {
  var card = ins.selectComponent('.tilt-body');
  if (card) {
    card.setStyle({
      'transition': 'transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275)',
      'transform': 'perspective(800px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)'
    });
  }
  var glare = ins.selectComponent('.glare-layer');
  if (glare) {
    glare.setStyle({
      'transition': 'opacity 0.4s ease',
      'opacity': '0'
    });
  }

  ins.callMethod('onTiltUpdate', {
    tiltX: '0.0',
    tiltY: '0.0',
    glare: 0
  });
}

module.exports = {
  touchStart: touchStart,
  touchMove: touchMove,
  touchEnd: touchEnd
};
