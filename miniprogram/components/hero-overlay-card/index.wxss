.hero-overlay-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.hud-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.city-card {
  width: 100%;
  background: #fbfbf9;
  border-radius: 40rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  color: #0f172a;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25);
}

.top-nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.nav-left {
  display: flex;
  flex-direction: column;
}

.sub-location {
  font-size: 20rpx;
  color: #71717a;
}

.loc-dropdown {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 2rpx;
}

.loc-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.loc-arrow {
  font-size: 24rpx;
  color: #71717a;
}

.avatar-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #0f172a;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

/* 01 大图头块占三分之一 */
.hero-cover-block {
  position: relative;
  width: 100%;
  height: 380rpx;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.15);
}

.hero-img {
  width: 100%;
  height: 100%;
}

.gradient-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.75) 100%);
}

.hero-overlay-content {
  position: absolute;
  inset: 0;
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #ffffff;
  box-sizing: border-box;
}

.hero-meta-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.depart-timer {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
}

.countdown-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.countdown-num {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.countdown-unit {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 2rpx;
}

.city-big-title {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.flight-flight {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.hero-bottom-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pack-status {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.pack-btn {
  background: #ffffff;
  color: #0f172a;
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

/* 下方天气与日期块 */
.weather-section {
  margin-top: 32rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid #e2e8f0;
}

.weather-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sec-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #0f172a;
}

.time-diff {
  font-size: 20rpx;
  color: #94a3b8;
}

.days-row {
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
}

.day-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 8rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  transition: all 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.day-name {
  font-size: 20rpx;
  color: #64748b;
  font-weight: 600;
}

.day-icon {
  font-size: 28rpx;
  margin: 8rpx 0;
}

.day-temp {
  font-size: 22rpx;
  font-weight: 800;
  color: #0f172a;
}

/* 03 当天用深色顶出来 (#151213) */
.day-col.active-black {
  background: #151213;
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 20rpx rgba(21, 18, 19, 0.3);
}

.day-col.active-black .day-name,
.day-col.active-black .day-temp {
  color: #ffffff;
}

/* 04 平滑曲线与游标跟踪 */
.curve-track-wrap {
  position: relative;
  width: 100%;
  height: 48rpx;
  margin-top: 16rpx;
}

.smooth-wave-line {
  position: absolute;
  left: 5%;
  right: 5%;
  top: 50%;
  height: 2rpx;
  background: linear-gradient(90deg, #e2e8f0 0%, #cbd5e1 50%, #e2e8f0 100%);
}

.curve-tracker-dot {
  position: absolute;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #151213;
  border: 4rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  transform: translate(-50%, -50%);
  transition: left 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.weather-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.tip-dot {
  color: #f59e0b;
  font-size: 28rpx;
}

.tip-text {
  font-size: 20rpx;
  color: #64748b;
}
