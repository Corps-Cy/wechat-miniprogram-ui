<view class="ring-wrapper {{visible ? 'active' : ''}}" wx:if="{{rendered}}">
  <!-- 背景遮罩：压暗到 40% (0.4) -->
  <view class="ring-mask" catchtouchmove="preventTouchMove" bindtap="handleClose"></view>

  <!-- 底部面板：0.5s 从屏幕外升起到位 -->
  <view class="ring-panel" catchtouchmove="preventTouchMove">
    <view class="close-corner" bindtap="handleClose">✕</view>

    <!-- 顶部标题 -->
    <view class="panel-header">
      <view class="brand-wrap">
        <text class="brand-name">QUILL</text>
        <text class="pass-sub">通兑 READING PASS</text>
      </view>
      <view class="status-tag">
        <text class="dot-green"></text>
        <text class="status-label">有效中</text>
      </view>
    </view>

    <!-- 中部双列布局：左圆环，右卡片信息 -->
    <view class="main-body">
      <!-- 左侧圆环 -->
      <view class="ring-box">
        <view class="conic-ring" style="--percent: {{displayPercent}};">
          <view class="ring-hole">
            <text class="ring-num">{{displayCount}}</text>
            <text class="ring-caption">剩余天数</text>
          </view>
        </view>
      </view>

      <!-- 右侧细则 -->
      <view class="info-box">
        <view class="info-group">
          <text class="info-k">有效期至</text>
          <text class="info-v date-strong">2027.03.10</text>
        </view>
        <view class="info-group">
          <text class="info-k">在读</text>
          <text class="info-v highlight-text">百年孤独</text>
        </view>
        <view class="info-group">
          <text class="info-k">编号</text>
          <text class="info-v mono-text">N° 0417</text>
        </view>
      </view>
    </view>

    <!-- 虚线分割线 -->
    <view class="dashed-divider"></view>

    <!-- 底部 3 字段元数据 -->
    <view class="meta-row">
      <view class="meta-col">
        <text class="meta-k">信用编码</text>
        <text class="meta-v">最新 LF......</text>
      </view>
      <view class="meta-col">
        <text class="meta-k">开卡日期</text>
        <text class="meta-v">2026.03.10</text>
      </view>
      <view class="meta-col">
        <text class="meta-k">年限</text>
        <text class="meta-v">1 年</text>
      </view>
    </view>

    <!-- 底部双操作按钮 -->
    <view class="action-row">
      <button class="btn-secondary" hover-class="btn-hover" bindtap="handleShelf">我的书架</button>
      <button class="btn-primary" hover-class="btn-hover" bindtap="handleContinue">继续阅读</button>
    </view>
  </view>
</view>
