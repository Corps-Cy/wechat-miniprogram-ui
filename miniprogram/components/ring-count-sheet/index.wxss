.ring-wrapper {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0.5s;
}

.ring-wrapper.active {
  visibility: visible;
  pointer-events: auto;
}

/* 背景压暗到 40% (0.4) */
.ring-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.ring-wrapper.active .ring-mask {
  background: rgba(0, 0, 0, 0.4);
}

/* 底部面板：从屏幕外升到位，耗时 0.5 秒 */
.ring-panel {
  position: relative;
  z-index: 2;
  background: #1c1c1e;
  border-radius: 44rpx 44rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%) translateZ(0);
  will-change: transform;
  -webkit-font-smoothing: antialiased;
  transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  box-shadow: 0 -16rpx 60rpx rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}

.ring-wrapper.active .ring-panel {
  transform: translateY(0) translateZ(0);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.close-corner {
  position: static;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #d4d4d8;
  flex-shrink: 0;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #f4f4f5;
  letter-spacing: 2rpx;
}

.pass-sub {
  display: block;
  font-size: 20rpx;
  color: #71717a;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

.status-tag {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

.dot-green {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #22c55e;
  margin-right: 8rpx;
}

.status-label {
  font-size: 20rpx;
  font-weight: 600;
  color: #f4f4f5;
}

/* 主体双列 */
.main-body {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

/* 左侧 CSS 锥形渐变圆环 */
.ring-box {
  width: 250rpx;
  height: 250rpx;
  margin-right: 40rpx;
  flex-shrink: 0;
}

.conic-ring {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(
    #ffffff 0deg,
    #ffffff calc(var(--percent, 0) * 3.6deg),
    rgba(255, 255, 255, 0.12) calc(var(--percent, 0) * 3.6deg),
    rgba(255, 255, 255, 0.12) 360deg
  );
  padding: 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-90deg);
}

.ring-hole {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #1c1c1e;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transform: rotate(90deg); /* 转回正常视角 */
}

.ring-num {
  font-size: 64rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: -2rpx;
  line-height: 1;
}

.ring-caption {
  font-size: 18rpx;
  color: #71717a;
  margin-top: 6rpx;
}

/* 右侧信息列表 */
.info-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-group {
  display: flex;
  flex-direction: column;
}

.info-k {
  font-size: 20rpx;
  color: #71717a;
}

.info-v {
  font-size: 26rpx;
  color: #e4e4e7;
  font-weight: 600;
  margin-top: 4rpx;
}

.date-strong {
  font-size: 28rpx;
  font-weight: 700;
}

.highlight-text {
  color: #ffffff;
}

.mono-text {
  font-family: monospace;
  color: #a1a1aa;
}

.dashed-divider {
  width: 100%;
  height: 1rpx;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.15);
  margin: 10rpx 0 32rpx;
}

/* 底部元数据 */
.meta-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.meta-col {
  display: flex;
  flex-direction: column;
}

.meta-k {
  font-size: 20rpx;
  color: #71717a;
}

.meta-v {
  font-size: 22rpx;
  font-weight: 500;
  color: #d4d4d8;
  margin-top: 6rpx;
}

/* 底部双按钮 */
.action-row {
  display: flex;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 100rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  margin: 0;
}

.btn-primary {
  flex: 1;
  background: #ffffff;
  color: #18181b;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 100rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  margin: 0;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}
