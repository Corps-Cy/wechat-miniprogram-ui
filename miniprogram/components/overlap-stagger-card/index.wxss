.layout-showcase-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.hud-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.showcase-card {
  width: 100%;
  background: #18181b;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 36rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.card-sub {
  display: block;
  font-size: 20rpx;
  color: #71717a;
  margin-top: 6rpx;
}

.mode-toggle {
  display: flex;
  background: #27272a;
  border-radius: 100rpx;
  padding: 6rpx;
  gap: 6rpx;
}

.mode-btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #a1a1aa;
  border-radius: 100rpx;
  transition: all 0.25s ease;
}

.mode-btn.active {
  background: #38bdf8;
  color: #0f172a;
}

/* 模式 1：OVERLAP 叠重 */
.overlap-stage {
  position: relative;
  width: 100%;
}

.hero-underlay {
  background: #27272a;
  border-radius: 28rpx;
  padding: 32rpx 32rpx 64rpx;
  margin-bottom: -44rpx; /* 压住标签 */
  position: relative;
  z-index: 1;
}

.underlay-tag {
  display: block;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #38bdf8;
}

.underlay-title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #ffffff;
  margin-top: 8rpx;
}

.cards-overlap-stack {
  position: relative;
  display: flex;
  flex-direction: column;
}

.overlap-item {
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-top: -24rpx; /* 卡片相互叠咬 24px */
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.4);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.25), box-shadow 0.3s;
}

.overlap-item.is-selected {
  transform: translateY(-16rpx) scale(1.02);
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.6);
  border-color: rgba(56, 189, 248, 0.6);
}

.card-press-active {
  transform: scale(0.96) !important;
}

.stagger-card.is-active-stagger {
  border-color: rgba(56, 189, 248, 0.6);
  box-shadow: 0 16rpx 36rpx rgba(56, 189, 248, 0.25);
  transform: translateY(-8rpx);
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
}

.item-price {
  font-size: 28rpx;
  font-weight: 800;
  color: #ffffff;
}

.item-body {
  margin-top: 20rpx;
}

.item-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.item-date {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
}

/* 模式 2：STAGGER 错位瀑布流 */
.stagger-stage {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.stagger-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.col-left {
  padding-top: 0;
}

.col-right {
  padding-top: 40rpx; /* 故意阶梯错位 40rpx，制造呼吸感 */
}

.stagger-card {
  border-radius: 28rpx;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.3);
}

.card-tall {
  height: 380rpx;
}

.card-short {
  height: 200rpx;
}

.card-medium {
  height: 240rpx;
}
