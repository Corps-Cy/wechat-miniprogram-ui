.photo-wrapper {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0.5s;
}

.photo-wrapper.active {
  visibility: visible;
  pointer-events: auto;
}

.photo-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.photo-wrapper.active .photo-mask {
  background: rgba(0, 0, 0, 0.5);
}

.photo-modal-card {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 上半部照片：从 1.08 缩小至 1.0 铺满 */
.photo-hero {
  position: relative;
  width: 680rpx;
  height: 440rpx;
  border-radius: 40rpx 40rpx 0 0;
  overflow: hidden;
  background: #27272a;
}

.hero-image {
  width: 100%;
  height: 100%;
  transform: scale(1.08);
  transform-origin: center center;
  transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.photo-wrapper.active .hero-image {
  transform: scale(1);
}

/* 暗角渐变托住白色大字 */
.hero-vignette {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.4) 0%,
    rgba(0, 0, 0, 0.1) 40%,
    rgba(0, 0, 0, 0.75) 100%
  );
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 32rpx 36rpx 60rpx;
  box-sizing: border-box;
}

.vignette-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
}

.dot-green {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #22c55e;
  margin-right: 8rpx;
}

.status-name {
  font-size: 18rpx;
  font-weight: 600;
  color: #ffffff;
}

.recipe-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.recipe-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 2rpx;
  margin-top: 4rpx;
  display: block;
}

.close-corner {
  position: static;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
  flex-shrink: 0;
}

/* 下半部抽屉：margin-top: -44rpx (-22px) 压住照片底边，从下方推入 */
.content-drawer {
  position: relative;
  z-index: 5;
  width: 680rpx;
  margin-top: -44rpx; /* 向上压住照片下沿 22px */
  background: #fbfbf9;
  border-radius: 36rpx;
  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 -8rpx 36rpx rgba(0, 0, 0, 0.12);
  transform: translateY(100%) translateZ(0);
  will-change: transform;
  -webkit-font-smoothing: antialiased;
  transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  transition-delay: 0.1s;
}

.photo-wrapper.active .content-drawer {
  transform: translateY(0) translateZ(0);
}

.drawer-hero {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.days-caption {
  font-size: 20rpx;
  color: #71717a;
}

.digits-line {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
}

.giant-num {
  font-size: 76rpx;
  font-weight: 900;
  color: #18181b;
  letter-spacing: -2rpx;
  line-height: 1;
}

.unit-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #18181b;
  margin-left: 8rpx;
}

.days-meta {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #a1a1aa;
  margin-top: 8rpx;
}

.meta-dot {
  margin: 0 8rpx;
}

/* 进度条：随后从 0 涨到 45% */
.progress-container {
  width: 100%;
  margin-bottom: 32rpx;
}

.progress-track {
  width: 100%;
  height: 12rpx;
  background: #e4e4e7;
  border-radius: 100rpx;
  overflow: hidden;
}

.progress-fill {
  width: 0%;
  height: 100%;
  background: #18181b;
  border-radius: 100rpx;
  transition: width 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  transition-delay: 0.35s;
}

.photo-wrapper:not(.active) .progress-fill {
  width: 0% !important;
  transition-delay: 0s;
}

/* 2x2 元信息 */
.meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #f4f4f5;
}

.meta-item {
  display: flex;
  flex-direction: column;
}

.meta-k {
  font-size: 18rpx;
  color: #a1a1aa;
}

.meta-v {
  font-size: 22rpx;
  font-weight: 600;
  color: #27272a;
  margin-top: 4rpx;
}

/* 底部按钮 */
.action-row {
  display: flex;
  gap: 18rpx;
}

.btn-secondary {
  flex: 1;
  background: #f4f4f5;
  color: #18181b;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 100rpx;
  padding: 20rpx 0;
  line-height: 1.4;
  margin: 0;
}

.btn-primary {
  flex: 1;
  background: #18181b;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 100rpx;
  padding: 20rpx 0;
  line-height: 1.4;
  margin: 0;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}
