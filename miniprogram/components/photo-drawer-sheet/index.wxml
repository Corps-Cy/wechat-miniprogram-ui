<view class="photo-wrapper {{visible ? 'active' : ''}}" wx:if="{{rendered}}">
  <view class="photo-mask" catchtouchmove="preventTouchMove" bindtap="handleClose"></view>

  <view class="photo-modal-card" catchtouchmove="preventTouchMove">
    <!-- 上半部沉浸式照片：从 1.08 缩小至 1.0，暗角托住白色大字 -->
    <view class="photo-hero">
      <image class="hero-image" src="{{imageUrl}}" mode="aspectFill" />
      <view class="hero-vignette">
        <view class="vignette-top">
          <text class="brand-text">FORAGE</text>
          <view class="status-pill">
            <text class="dot-green"></text>
            <text class="status-name">有效中</text>
          </view>
        </view>
        <view class="vignette-bottom">
          <text class="recipe-title">拾味</text>
          <text class="recipe-sub">RECIPE BOOK</text>
        </view>
      </view>
      <view class="close-corner" bindtap="handleClose">✕</view>
    </view>

    <!-- 下半部抽屉：margin-top: -44rpx (-22px) 压住照片底边，从下方推入 -->
    <view class="content-drawer">
      <view class="drawer-hero">
        <text class="days-caption">剩余天数</text>
        <view class="digits-line">
          <text class="giant-num">{{displayDays}}</text>
          <text class="unit-text">天</text>
        </view>
        <view class="days-meta">
          <text>已使用 202 天</text>
          <text class="meta-dot">·</text>
          <text>共 365 天</text>
        </view>
      </view>

      <!-- 进度条随后从 0 涨到剩余比例 (约 45%) -->
      <view class="progress-container">
        <view class="progress-track">
          <view class="progress-fill" style="width: {{progressRatio}}%;"></view>
        </view>
      </view>

      <!-- 详细条目 2x2 -->
      <view class="meta-grid">
        <view class="meta-item">
          <text class="meta-k">有效期至</text>
          <text class="meta-v">2027.03.10</text>
        </view>
        <view class="meta-item">
          <text class="meta-k">服务类型</text>
          <text class="meta-v">三文鱼什锦碗</text>
        </view>
        <view class="meta-item">
          <text class="meta-k">已绑定</text>
          <text class="meta-v">微信</text>
        </view>
        <view class="meta-item">
          <text class="meta-k">年限</text>
          <text class="meta-v">1 年</text>
        </view>
      </view>

      <!-- 底部双操作按钮 -->
      <view class="action-row">
        <button class="btn-secondary" hover-class="btn-hover" bindtap="handleChange">换一道</button>
        <button class="btn-primary" hover-class="btn-hover" bindtap="handleUse">核销</button>
      </view>
    </view>
  </view>
</view>
