.stagger-wrap {
  width: 100%;
  background: #18181b;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 36rpx 36rpx 40rpx;
  box-sizing: border-box;
  margin: 0;
}

.stagger-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.title-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.main-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
}

.sub-count {
  font-size: 20rpx;
  color: #71717a;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.replay-btn {
  font-size: 20rpx;
  font-weight: 700;
  color: #f4f4f5;
  background: #27272a;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 6rpx 18rpx;
  border-radius: 100rpx;
  cursor: pointer;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #f97316;
  background: rgba(249, 115, 22, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

/* 2 列网格瀑布流 */
.masonry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.grid-item {
  position: relative;
  height: 180rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #27272a;
  transform: translateY(60rpx) scale(0.92);
  opacity: 0;
  transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.2),
              opacity 0.4s ease;
  transition-delay: var(--cascade-delay);
  will-change: transform, opacity;
}

.grid-item.entered {
  transform: translateY(0) scale(1);
  opacity: 1;
}

.item-hover {
  transform: scale(0.95) !important;
  transition: transform 0.1s ease !important;
  opacity: 0.9;
}

.grid-img {
  width: 100%;
  height: 100%;
}

.item-label {
  position: absolute;
  bottom: 12rpx;
  left: 14rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
