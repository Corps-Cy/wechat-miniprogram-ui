.elastic-sheet-wrapper {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0.4s;
}

.elastic-sheet-wrapper.active {
  visibility: visible;
  pointer-events: auto;
}

.sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.elastic-sheet-wrapper.active .sheet-mask {
  background: rgba(0, 0, 0, 0.5);
}

.elastic-panel {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 760rpx; /* 初始 MID 高度 */
  background: #fbfbf9;
  border-radius: 44rpx 44rpx 0 0;
  padding: 24rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  box-shadow: 0 -16rpx 60rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
}

.elastic-sheet-wrapper.active .elastic-panel {
  transform: translateY(0);
}

.drag-handle-bar {
  padding: 16rpx 0 24rpx;
  display: flex;
  justify-content: center;
  cursor: grab;
}

.handle-line {
  width: 80rpx;
  height: 8rpx;
  background: #d4d4d8;
  border-radius: 4rpx;
}

.hud-anchor-bar {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.anchor-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #a1a1aa;
  background: #f4f4f5;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.anchor-pill.active {
  color: #f97316;
  background: rgba(249, 115, 22, 0.12);
}

.sheet-inner {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sheet-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #18181b;
}

.sheet-subtitle {
  font-size: 20rpx;
  font-weight: 700;
  color: #71717a;
  letter-spacing: 2rpx;
  margin: 20rpx 0 12rpx;
}

.size-selector {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.size-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 1rpx solid #e4e4e7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #3f3f46;
}

.active-circle {
  background: #f97316;
  border-color: #f97316;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(249, 115, 22, 0.35);
}

.angle-display {
  background: #ffffff;
  border: 1rpx solid #e4e4e7;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #18181b;
}

.save-btn {
  margin-top: auto;
  width: 100%;
  background: #18181b;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 100rpx;
  padding: 22rpx 0;
  line-height: 1.4;
}
