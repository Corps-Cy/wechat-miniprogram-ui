var startY = 0;
var isExpanded = false;
var MAX_EXPAND = 240; // 最大展开高度 px
var SNAP_THRESHOLD = 70; // 40% 吸附阈值

function touchStart(e, ins) {
  var touch = e.touches[0] || e.changedTouches[0];
  startY = touch.clientY;
  ins.selectComponent('.unfold-receipt').setStyle({
    'transition': 'none'
  });
  ins.selectComponent('.pull-handle').setStyle({
    'transition': 'none'
  });
}

function touchMove(e, ins) {
  var touch = e.touches[0] || e.changedTouches[0];
  var deltaY = touch.clientY - startY;

  if (!isExpanded) {
    if (deltaY > 0) {
      var height = Math.min(deltaY * 0.85, MAX_EXPAND);
      // 增加 2° 物理微摆动 (SWING: 2°)
      var swing = Math.sin(deltaY / 15) * 2;
      ins.selectComponent('.unfold-receipt').setStyle({
        'height': height + 'px',
        'opacity': Math.min(height / 60, 1),
        'transform': 'rotate(' + swing + 'deg)'
      });
      ins.selectComponent('.handle-chevron').setStyle({
        'transform': 'rotate(180deg) scale(1.15)'
      });
    }
  } else {
    // 已展开时向上推收起
    if (deltaY < 0) {
      var height = Math.max(MAX_EXPAND + deltaY, 0);
      ins.selectComponent('.unfold-receipt').setStyle({
        'height': height + 'px'
      });
    }
  }
}

function touchEnd(e, ins) {
  var touch = e.touches[0] || e.changedTouches[0];
  var deltaY = touch.clientY - startY;

  ins.selectComponent('.unfold-receipt').setStyle({
    'transition': 'height 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s, transform 0.3s ease'
  });
  ins.selectComponent('.pull-handle').setStyle({
    'transition': 'transform 0.3s ease'
  });

  if (!isExpanded) {
    if (deltaY > SNAP_THRESHOLD) {
      // 超过 40% 阈值吸附完全展开
      isExpanded = true;
      ins.selectComponent('.unfold-receipt').setStyle({
        'height': MAX_EXPAND + 'px',
        'opacity': '1',
        'transform': 'rotate(0deg)'
      });
      ins.selectComponent('.handle-chevron').setStyle({
        'transform': 'rotate(180deg)'
      });
      ins.callMethod('onStateChange', { expanded: true });
    } else {
      // 回弹收起
      ins.selectComponent('.unfold-receipt').setStyle({
        'height': '0px',
        'opacity': '0',
        'transform': 'rotate(0deg)'
      });
      ins.selectComponent('.handle-chevron').setStyle({
        'transform': 'rotate(0deg)'
      });
    }
  } else {
    if (deltaY < -SNAP_THRESHOLD) {
      // 向上推超过阈值，收起
      isExpanded = false;
      ins.selectComponent('.unfold-receipt').setStyle({
        'height': '0px',
        'opacity': '0',
        'transform': 'rotate(0deg)'
      });
      ins.selectComponent('.handle-chevron').setStyle({
        'transform': 'rotate(0deg)'
      });
      ins.callMethod('onStateChange', { expanded: false });
    } else {
      // 保持展开
      ins.selectComponent('.unfold-receipt').setStyle({
        'height': MAX_EXPAND + 'px',
        'opacity': '1',
        'transform': 'rotate(0deg)'
      });
      ins.selectComponent('.handle-chevron').setStyle({
        'transform': 'rotate(180deg)'
      });
    }
  }
}

function onVisibleChange(newVal, oldVal, ownerInstance, ins) {
  if (newVal) {
    isExpanded = false;
    var receipt = ownerInstance.selectComponent('.unfold-receipt');
    var chevron = ownerInstance.selectComponent('.handle-chevron');
    if (receipt) {
      receipt.setStyle({
        'height': '0px',
        'opacity': '0',
        'transform': 'rotate(0deg)'
      });
    }
    if (chevron) {
      chevron.setStyle({
        'transform': 'rotate(0deg)'
      });
    }
  }
}

module.exports = {
  touchStart: touchStart,
  touchMove: touchMove,
  touchEnd: touchEnd,
  onVisibleChange: onVisibleChange
};
