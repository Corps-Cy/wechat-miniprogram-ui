.scatter-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.hud-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #ef4444;
  background: rgba(239, 68, 68, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.inbox-card {
  width: 100%;
  background: #18181b;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 36rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.total-badge {
  padding: 2rpx 14rpx;
  background: #ef4444;
  border-radius: 100rpx;
  transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.25);
  transform-origin: center;
}

.total-badge.hidden {
  transform: scale(0);
  opacity: 0;
}

.total-badge.visible {
  transform: scale(1);
  opacity: 1;
}

.badge-num {
  font-size: 20rpx;
  font-weight: 800;
  color: #ffffff;
}

.reset-btn {
  font-size: 22rpx;
  color: #a1a1aa;
  padding: 6rpx 18rpx;
  background: #27272a;
  border-radius: 100rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.cat-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.cat-tab {
  position: relative;
  padding: 10rpx 24rpx;
  background: #27272a;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cat-tab.active {
  background: #3f3f46;
}

.cat-name {
  font-size: 22rpx;
  color: #d4d4d8;
  font-weight: 600;
}

.cat-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ef4444;
}

.msg-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.msg-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #27272a;
  border-radius: 20rpx;
  padding: 24rpx;
  transition: background 0.25s, transform 0.2s;
}

.msg-item.item-highlight {
  background: #3f3f46;
  transform: scale(1.01);
}

.msg-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}

.msg-title.unread-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.msg-title.read-title {
  font-size: 26rpx;
  color: #71717a;
}

.msg-status {
  font-size: 20rpx;
  color: #71717a;
}

.dot-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 核心：红点沿弧线收回再消散 */
.rebound-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 12rpx rgba(239, 68, 68, 0.6);
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  will-change: transform, opacity;
}

.rebound-dot.dissipating {
  /* 弧线位移 + 缩放收束 */
  transform: translate3d(-20rpx, -14rpx, 0) scale(0);
  opacity: 0;
}
