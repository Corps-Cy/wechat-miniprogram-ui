.swipe-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.hud-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #f97316;
  background: rgba(249, 115, 22, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.stack-stage {
  position: relative;
  width: 580rpx;
  height: 520rpx;
}

.stack-card {
  position: absolute;
  inset: 0;
  border-radius: 40rpx;
  background: #18181b;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}

.under-card {
  transform: scale(0.94);
  z-index: 1;
}

.top-card {
  z-index: 2;
  cursor: grab;
}

.card-img {
  width: 100%;
  height: 380rpx;
}

.card-foot {
  padding: 20rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.foot-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
}

.foot-sub {
  font-size: 20rpx;
  color: #71717a;
  margin-top: 4rpx;
}

.hint-text {
  font-size: 20rpx;
  color: #71717a;
  margin-top: 24rpx;
}
