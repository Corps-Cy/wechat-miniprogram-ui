var startX = 0;
var THRESHOLD = 100;

function touchStart(e, ins) {
  var touch = e.touches[0] || e.changedTouches[0];
  startX = touch.clientX;
  ins.selectComponent('.top-card').setStyle({
    'transition': 'none'
  });
}

function touchMove(e, ins) {
  var touch = e.touches[0] || e.changedTouches[0];
  var deltaX = touch.clientX - startX;
  var rot = (deltaX / 150) * 12; // 随位移旋转角度

  ins.selectComponent('.top-card').setStyle({
    'transform': 'translate3d(' + deltaX + 'px, 0, 0) rotate(' + rot.toFixed(1) + 'deg)'
  });

  // 底层卡片从 0.94 逐渐放大至 1.0
  var progress = Math.min(Math.abs(deltaX) / THRESHOLD, 1);
  var nextScale = 0.94 + progress * 0.06;
  ins.selectComponent('.under-card').setStyle({
    'transform': 'scale(' + nextScale.toFixed(2) + ')'
  });
}

function touchEnd(e, ins) {
  var touch = e.touches[0] || e.changedTouches[0];
  var deltaX = touch.clientX - startX;

  if (Math.abs(deltaX) > THRESHOLD) {
    // 飞走
    var flyX = deltaX > 0 ? 500 : -500;
    ins.selectComponent('.top-card').setStyle({
      'transition': 'transform 0.35s ease-out, opacity 0.3s',
      'transform': 'translate3d(' + flyX + 'px, 0, 0) rotate(' + (flyX > 0 ? 25 : -25) + 'deg)',
      'opacity': '0'
    });
    ins.selectComponent('.under-card').setStyle({
      'transition': 'transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1)',
      'transform': 'scale(1.0)'
    });
    ins.callMethod('onCardSwiped');
  } else {
    // 回弹复位
    ins.selectComponent('.top-card').setStyle({
      'transition': 'transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.25)',
      'transform': 'translate3d(0, 0, 0) rotate(0deg)'
    });
    ins.selectComponent('.under-card').setStyle({
      'transition': 'transform 0.4s ease',
      'transform': 'scale(0.94)'
    });
  }
}

module.exports = {
  touchStart: touchStart,
  touchMove: touchMove,
  touchEnd: touchEnd
};
