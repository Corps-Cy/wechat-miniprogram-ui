<wxs module="swipeHandler" src="./swipe.wxs"></wxs>

<view class="swipe-container">
  <view class="hud-bar">
    <text class="hud-pill">ROTATE: ±12°</text>
    <text class="hud-pill">NEXT_SCALE: 0.94 → 1.00</text>
  </view>

  <view class="stack-stage">
    <!-- 底层卡片 (scale 0.94) -->
    <view class="stack-card under-card">
      <image class="card-img" src="{{nextCard.url}}" mode="aspectFill" />
      <view class="card-foot">
        <text class="foot-title">{{nextCard.title}}</text>
        <text class="foot-sub">{{nextCard.sub}}</text>
      </view>
    </view>

    <!-- 顶层卡片 (随手指滑动甩飞) -->
    <view 
      class="stack-card top-card"
      bindtouchstart="{{swipeHandler.touchStart}}"
      bindtouchmove="{{swipeHandler.touchMove}}"
      bindtouchend="{{swipeHandler.touchEnd}}"
    >
      <image class="card-img" src="{{currentCard.url}}" mode="aspectFill" />
      <view class="card-foot">
        <text class="foot-title">{{currentCard.title}}</text>
        <text class="foot-sub">{{currentCard.sub}}</text>
      </view>
    </view>
  </view>

  <text class="hint-text">左右划动单手连续切卡，松手弹性回弹</text>
</view>
