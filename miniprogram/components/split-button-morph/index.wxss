.split-card {
  width: 100%;
  background: #18181b;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 36rpx 40rpx 44rpx;
  box-sizing: border-box;
  margin: 0;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
}

.hud-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.carry-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #71717a;
  letter-spacing: 2rpx;
}

.timer-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  margin-top: 4rpx;
}

.timer-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 36rpx 0 44rpx;
}

.timer-num {
  font-family: monospace;
  font-size: 96rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: -2rpx;
  line-height: 1;
}

.timer-state-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #71717a;
  letter-spacing: 2rpx;
  margin-top: 12rpx;
}

/* 按钮分裂容器 */
.button-split-wrapper {
  position: relative;
  width: 100%;
  height: 104rpx;
}

/* 初态单按钮 */
.btn-single-start {
  width: 100%;
  height: 100%;
  background: #fbbf24;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(251, 191, 36, 0.35);
  cursor: pointer;
  transform: scale(1);
  transition: transform 0.15s ease;
}

.btn-label {
  font-size: 32rpx;
  font-weight: 800;
  color: #18181b;
}

.dot-play {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #18181b;
}

/* 分裂态：双按钮弹性展开 */
.split-twins {
  display: flex;
  width: 100%;
  height: 100%;
  gap: 32rpx; /* 16px */
  animation: split-spring 0.45s cubic-bezier(0.34, 1.36, 0.5, 1) forwards;
}

@keyframes split-spring {
  0% { gap: 0rpx; transform: scale(0.96); }
  100% { gap: 32rpx; transform: scale(1); }
}

.btn-pause {
  flex: 1;
  background: #27272a;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-end {
  flex: 1;
  background: #fbbf24;
  color: #18181b;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(251, 191, 36, 0.3);
}

.btn-hover {
  transform: scale(0.96);
  opacity: 0.9;
}
