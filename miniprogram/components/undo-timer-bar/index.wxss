.undo-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.hud-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #f97316;
  background: rgba(249, 115, 22, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.todo-card {
  width: 100%;
  background: #18181b;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 36rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
  position: relative;
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.reset-link {
  font-size: 20rpx;
  font-weight: 700;
  color: #f97316;
  background: rgba(249, 115, 22, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  cursor: pointer;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.card-tip {
  font-size: 22rpx;
  color: #71717a;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-height: 260rpx;
}

.task-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #27272a;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  transition: all 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.task-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.check-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #71717a;
  flex-shrink: 0;
}

.task-info {
  display: flex;
  flex-direction: column;
}

.task-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #f4f4f5;
}

.task-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 6rpx;
}

.task-tag {
  font-size: 20rpx;
  color: #f97316;
  background: rgba(249, 115, 22, 0.15);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 700;
}

.task-time {
  font-size: 20rpx;
  color: #71717a;
}

.delete-btn {
  font-size: 36rpx;
  color: #71717a;
  padding: 0 16rpx;
  line-height: 1;
}

.empty-hint {
  text-align: center;
  color: #52525b;
  font-size: 24rpx;
  padding: 60rpx 0;
}

/* 底部撤销浮条 */
.undo-bar-wrap {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  transform: translateY(140%);
  opacity: 0;
  transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.25), opacity 0.3s;
  pointer-events: none;
}

.undo-bar-wrap.show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.undo-bar {
  background: #3f3f46;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.5);
}

.undo-bar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
}

.undo-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.undo-action {
  padding: 6rpx 20rpx;
  background: #f97316;
  border-radius: 100rpx;
}

.undo-btn-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
}

/* 进度条：走完才消失 */
.progress-track {
  width: 100%;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.1);
}

.progress-fill {
  height: 100%;
  background: #f97316;
  transition: width 0.05s linear;
}
