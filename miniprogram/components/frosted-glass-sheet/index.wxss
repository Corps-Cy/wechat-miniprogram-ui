.frosted-wrapper {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0.45s;
}

.frosted-wrapper.active {
  visibility: visible;
  pointer-events: auto;
}

/* 背景毛玻璃遮罩：模糊从 0 到 26px */
.frosted-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(0px);
  -webkit-backdrop-filter: blur(0px);
  opacity: 0;
  transition: opacity 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
              backdrop-filter 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
              -webkit-backdrop-filter 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.frosted-wrapper.active .frosted-mask {
  opacity: 1;
  backdrop-filter: blur(26px);
  -webkit-backdrop-filter: blur(26px);
}

/* 半透明浮起面板：从 0.94 放大至 1，底色 rgba(255, 255, 255, 0.42) */
.frosted-panel {
  position: relative;
  z-index: 2;
  width: 660rpx;
  background: rgba(255, 255, 255, 0.42);
  border: 1.5rpx solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.15),
              inset 0 1rpx 2rpx rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 48rpx;
  padding: 44rpx 40rpx 40rpx;
  box-sizing: border-box;
  transform: translateY(30rpx) scale(0.96) translateZ(0);
  opacity: 0;
  -webkit-font-smoothing: antialiased;
  backface-visibility: hidden;
  will-change: transform, opacity;
  transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
              opacity 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.frosted-wrapper.active .frosted-panel {
  transform: translateY(0) scale(1) translateZ(0);
  opacity: 1;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.close-corner {
  position: static;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #374151;
  flex-shrink: 0;
}

/* 顶部标题行 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.title-en {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #111827;
}

.title-cn {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.status-badge {
  display: flex;
  align-items: center;
  background: rgba(17, 24, 39, 0.06);
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #10b981;
  margin-right: 8rpx;
}

.badge-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #111827;
}

/* 核心数字 */
.stat-hero {
  margin: 16rpx 0 36rpx;
}

.giant-num {
  font-size: 88rpx;
  font-weight: 900;
  color: #111827;
  letter-spacing: -2rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.stat-desc {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 10rpx;
}

/* 12 个月份胶囊行 */
.months-timeline {
  position: relative;
  margin: 40rpx 0 36rpx;
  padding-top: 40rpx;
}

.today-bubble {
  position: absolute;
  top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  transition: opacity 0.3s;
}

.bubble-text {
  background: #111827;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.bubble-arrow {
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 6rpx solid #111827;
}

.capsules-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 76rpx;
}

.capsule-track {
  width: 32rpx;
  height: 76rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

/* 填充条：每格错开 4 帧 (~66ms)，1s 内完成 */
.capsule-fill {
  width: 100%;
  height: 0%;
  background: #111827;
  border-radius: 16rpx;
  transition: height 1s cubic-bezier(0.2, 0.7, 0.2, 1);
  transition-delay: var(--stagger-delay);
}

.frosted-wrapper:not(.active) .capsule-fill {
  height: 0% !important;
  transition-duration: 0.1s;
  transition-delay: 0s;
}

/* 2x2 信息网格 */
.meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
}

.meta-label {
  font-size: 20rpx;
  color: #9ca3af;
}

.meta-val {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
  margin-top: 4rpx;
}

/* 底部按钮 */
.action-footer {
  width: 100%;
}

.primary-btn {
  width: 100%;
  background: #111827;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 100rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  margin: 0;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.2);
}

.btn-hover {
  transform: scale(0.97);
  opacity: 0.92;
}
