<view class="bento-container">
  <!-- 顶部超粗两行标题 -->
  <view class="bento-header">
    <text class="title-cn">习惯墙</text>
    <text class="title-en">Habit Wall.</text>
  </view>

  <!-- 亮黄大色块主角卡片 (HERO BENTO) -->
  <view class="hero-bento">
    <view class="bento-top">
      <view class="stat-left">
        <view class="giant-num-wrap">
          <text class="num-large">{{completedCount}}</text>
          <text class="num-slash">/{{totalHabits}}</text>
        </view>
        <text class="stat-summary">今日完成 · 还有 {{totalHabits - completedCount}} 个待打卡</text>
      </view>

      <!-- 环形完成度动态更新 -->
      <view class="ring-73">
        <text class="ring-num">{{ringPercent}}%</text>
      </view>
    </view>

    <!-- 状态小胶囊：可点击筛选联动 -->
    <view class="pills-row">
      <view 
        class="pill-item {{activeFilter === 'all' ? 'active-pill' : ''}}"
        bindtap="setFilter" 
        data-filter="all"
      >全部 {{totalHabits}}</view>
      <view 
        class="pill-item {{activeFilter === 'pending' ? 'active-pill' : ''}}"
        bindtap="setFilter" 
        data-filter="pending"
      >待打卡 {{totalHabits - completedCount}}</view>
      <view 
        class="pill-item {{activeFilter === 'done' ? 'active-pill' : ''}}"
        bindtap="setFilter" 
        data-filter="done"
      >已完成 {{completedCount}}</view>
    </view>
  </view>

  <!-- 四列等宽小格打卡项 (4COL GRID) -->
  <view class="four-col-grid">
    <block wx:for="{{filteredHabits}}" wx:key="id">
      <view 
        class="habit-box {{item.done ? 'is-done' : ''}}" 
        hover-class="box-hover"
        bindtap="toggleHabit" 
        data-id="{{item.id}}"
      >
        <text class="habit-icon">{{item.icon}}</text>
        <text class="habit-name">{{item.name}}</text>
        <text class="habit-time">{{item.time}}</text>
        <view class="check-dot">{{item.done ? '✓' : ''}}</view>
      </view>
    </block>
  </view>
</view>
