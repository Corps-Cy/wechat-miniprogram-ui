.glow-container {
  position: relative;
  width: 620rpx;
  height: 340rpx;
  margin: 30rpx auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弥散呼吸背光 */
.diffuse-glow-bg {
  position: absolute;
  inset: -10rpx;
  background: radial-gradient(circle, rgba(249, 115, 22, 0.45) 0%, rgba(249, 115, 22, 0) 70%);
  filter: blur(28px);
  -webkit-filter: blur(28px);
  border-radius: 44rpx;
  z-index: 1;
  animation: breathe 3s ease-in-out infinite alternate;
}

@keyframes breathe {
  0% { opacity: 0.45; transform: scale(0.96); }
  100% { opacity: 0.9; transform: scale(1.04); }
}

/* 2px 旋转描边容器 */
.conic-border-box {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  border-radius: 36rpx;
  padding: 3rpx; /* 形成 2~3px 细微描边 */
  box-sizing: border-box;
  overflow: hidden;
  background: #18181b;
}

/* 旋转的锥形渐变光斑 */
.conic-border-box::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(
    transparent 0deg,
    transparent 280deg,
    #f97316 330deg,
    #fbbf24 360deg
  );
  animation: rotate-conic 4s linear infinite;
}

@keyframes rotate-conic {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.card-inner {
  position: relative;
  z-index: 3;
  width: 100%;
  height: 100%;
  background: #18181b;
  border-radius: 34rpx;
  padding: 36rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.coach-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sparkle {
  color: #f97316;
  font-size: 24rpx;
}

.badge-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #f4f4f5;
  letter-spacing: 2rpx;
}

.glow-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(249, 115, 22, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
}

.glow-indicator {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #f97316;
  box-shadow: 0 0 8rpx #f97316;
}

.glow-txt {
  font-size: 18rpx;
  font-weight: 700;
  color: #f97316;
  letter-spacing: 1rpx;
}

.stat-group {
  margin: 10rpx 0;
}

.stat-caption {
  font-size: 20rpx;
  color: #71717a;
}

.stat-num-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.stat-large {
  font-size: 64rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: -2rpx;
  line-height: 1;
}

.stat-unit {
  font-size: 26rpx;
  font-weight: 600;
  color: #71717a;
}

.chart-preview {
  height: 50rpx;
  display: flex;
  align-items: center;
}

.spark-line {
  position: relative;
  width: 100%;
  height: 4rpx;
  background: linear-gradient(90deg, #3f3f46 0%, #f97316 70%, #fbbf24 100%);
  border-radius: 2rpx;
}

.line-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fbbf24;
  box-shadow: 0 0 10rpx #fbbf24;
  top: -3rpx;
}

.dot-1 { left: 20%; }
.dot-2 { left: 60%; }
.dot-3 { right: 0; }
