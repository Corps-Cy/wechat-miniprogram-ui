.dial-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.hud-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #c084fc;
  background: rgba(192, 132, 252, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

/* 紫色高饱和海报风格卡片主体 */
.poster-card {
  width: 100%;
  background: #7c3aed;
  color: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 50rpx rgba(124, 58, 237, 0.35);
  overflow: hidden;
}

.poster-header {
  margin-bottom: 24rpx;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.avatar-badge {
  font-size: 24rpx;
}

.room-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 600;
}

.poster-title-block {
  display: flex;
  flex-direction: column;
}

.poster-title {
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  line-height: 1.05;
}

/* 半圆弧形转盘舞台 */
.dial-stage {
  position: relative;
  width: 100%;
  height: 480rpx;
  background: rgba(0, 0, 0, 0.18);
  border-radius: 36rpx;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 32rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部固定指针 */
.top-pointer {
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #facc15;
  font-size: 26rpx;
  z-index: 5;
}

/* 弧形转盘轨道 */
.arc-track-container {
  position: absolute;
  top: 40rpx;
  width: 100%;
  height: 240rpx;
}

.rotating-dial {
  position: absolute;
  left: 50%;
  top: 220rpx;
  width: 0;
  height: 0;
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.25);
}

.dial-item-node {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  transform-origin: center center;
}

.node-bubble {
  position: absolute;
  left: -48rpx;
  top: -48rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.node-icon {
  font-size: 26rpx;
  line-height: 1;
}

.node-name {
  font-size: 16rpx;
  font-weight: 700;
  color: #ffffff;
  margin-top: 2rpx;
}

.node-quota {
  font-size: 14rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 停在指针正上方的高亮节点 */
.dial-item-node.active-node .node-bubble {
  background: #facc15;
  border-color: #fde047;
  transform: scale(1.18);
  box-shadow: 0 8rpx 24rpx rgba(250, 204, 21, 0.4);
}

.dial-item-node.active-node .node-name,
.dial-item-node.active-node .node-quota {
  color: #0f172a;
}

/* 中间计时器与按键 */
.dial-center-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 3;
}

.round-status {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.8);
}

.big-timer {
  font-size: 68rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  margin: 6rpx 0 16rpx;
}

.dial-action-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.start-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #18181b;
  padding: 12rpx 32rpx;
  border-radius: 100rpx;
}

.start-lbl {
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
}

.task-active-tag {
  font-size: 20rpx;
  font-weight: 700;
  background: #facc15;
  color: #0f172a;
  padding: 2rpx 12rpx;
  border-radius: 100rpx;
}

/* 底部打卡数据统计 */
.streak-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  color: #0f172a;
  border-radius: 32rpx;
  padding: 24rpx 32rpx;
}

.streak-col {
  display: flex;
  flex-direction: column;
}

.streak-lbl {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #71717a;
}

.streak-val {
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.1;
  color: #7c3aed;
}

.streak-sub {
  font-size: 20rpx;
  color: #71717a;
  margin-top: 4rpx;
}

.streak-bars {
  display: flex;
  gap: 10rpx;
  align-items: flex-end;
}

.bar-pill {
  width: 24rpx;
  background: #e4e4e7;
  border-radius: 100rpx;
}

.bar-1 { height: 40rpx; }
.bar-2 { height: 60rpx; }
.bar-3 { height: 80rpx; }

.active-bar {
  background: #a855f7;
}
