<view class="flip-wrapper {{visible ? 'active' : ''}}" wx:if="{{rendered}}">
  <view class="flip-mask" catchtouchmove="preventTouchMove" bindtap="handleClose"></view>

  <view class="flip-stage" catchtouchmove="preventTouchMove">
    <view class="close-corner" bindtap="handleClose">✕</view>

    <!-- 3D 翻转卡片 perspective: 1200px -->
    <view class="flip-card {{flipped ? 'is-flipped' : ''}}">
      
      <!-- 【正面】常规凭证信息 -->
      <view class="card-face card-front">
        <view class="face-top">
          <view class="brand-group">
            <text class="brand-title">NOMAD</text>
            <text class="brand-sub">ROAD PASS</text>
          </view>
          <view class="status-pill">
            <text class="dot-green"></text>
            <text class="status-text">有效中</text>
          </view>
        </view>

        <view class="face-center">
          <view class="days-row">
            <text class="giant-num">163</text>
            <text class="days-unit">天 · 剩余天数</text>
          </view>

          <view class="info-block">
            <view class="info-item">
              <text class="k-text">有效截至</text>
              <text class="v-text">2027.03.10</text>
            </view>
            <view class="info-item">
              <text class="k-text">上一站</text>
              <text class="v-text">柏林营地</text>
            </view>
          </view>
        </view>

        <view class="face-bottom">
          <button class="flip-action-btn" hover-class="btn-hover" bindtap="handleFlip">
            查看凭证 ↷
          </button>
        </view>
      </view>

      <!-- 【背面】到场需要出示的信息 -->
      <view class="card-face card-back">
        <view class="face-top">
          <view class="brand-group">
            <text class="brand-title">NOMAD</text>
            <text class="brand-sub">到场出示凭证</text>
          </view>
        </view>

        <view class="face-center">
          <view class="verify-box">
            <text class="verify-label">入营编号</text>
            <text class="verify-code">LF7K-2QXP</text>
            <text class="verify-tip">到场向工作人员出示此编号核销</text>
          </view>

          <view class="back-grid">
            <view class="grid-cell">
              <text class="k-text">车型</text>
              <text class="v-text">双人房车</text>
            </view>
            <view class="grid-cell">
              <text class="k-text">生效日期</text>
              <text class="v-text">2026.03.10</text>
            </view>
            <view class="grid-cell">
              <text class="k-text">上一站</text>
              <text class="v-text">柏林营地</text>
            </view>
            <view class="grid-cell">
              <text class="k-text">年限</text>
              <text class="v-text">1 年</text>
            </view>
          </view>
        </view>

        <view class="face-bottom">
          <button class="flip-action-btn back-btn" hover-class="btn-hover" bindtap="handleFlip">
            返回 ↶
          </button>
        </view>
      </view>

    </view>
  </view>
</view>
