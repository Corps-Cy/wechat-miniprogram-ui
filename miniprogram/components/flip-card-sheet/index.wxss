.flip-wrapper {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0.4s;
}

.flip-wrapper.active {
  visibility: visible;
  pointer-events: auto;
}

.flip-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.flip-wrapper.active .flip-mask {
  background: rgba(0, 0, 0, 0.65);
}

/* 3D 舞台：perspective: 1200px */
.flip-stage {
  perspective: 1200px;
  position: relative;
  z-index: 2;
  width: 650rpx;
  height: 860rpx;
}

.close-corner {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 10;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #a1a1aa;
}

.flip-card {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  will-change: transform;
}

/* 翻转 180 度 */
.flip-card.is-flipped {
  transform: rotateY(180deg);
}

/* 正反卡面基础 */
.card-face {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
  background: #1c1c1e;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.4);
  padding: 44rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* 正面 */
.card-front {
  transform: rotateY(0deg);
}

/* 背面 */
.card-back {
  transform: rotateY(180deg);
  background: #18181b;
}

.face-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.brand-group {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #f4f4f5;
  letter-spacing: 2rpx;
}

.brand-sub {
  font-size: 20rpx;
  color: #71717a;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

.dot-green {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #22c55e;
  margin-right: 8rpx;
}

.status-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #f4f4f5;
}

.face-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20rpx 0;
}

.days-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 36rpx;
}

.giant-num {
  font-size: 96rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: -2rpx;
  line-height: 1;
}

.days-unit {
  font-size: 24rpx;
  color: #71717a;
  margin-top: 10rpx;
}

.info-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  padding: 24rpx;
  border-radius: 20rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}

.k-text {
  color: #71717a;
}

.v-text {
  color: #e4e4e7;
  font-weight: 600;
}

/* 背面样式 */
.verify-box {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx dashed rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.verify-label {
  font-size: 20rpx;
  color: #71717a;
}

.verify-code {
  font-family: monospace;
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 6rpx;
  margin: 12rpx 0 8rpx;
}

.verify-tip {
  font-size: 18rpx;
  color: #a1a1aa;
}

.back-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx 20rpx;
  background: rgba(255, 255, 255, 0.04);
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
}

.grid-cell {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 22rpx;
}

/* 按钮 */
.flip-action-btn {
  width: 100%;
  background: #ffffff;
  color: #18181b;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 100rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  margin: 0;
}

.back-btn {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}
