.odometer-card {
  width: 100%;
  background: #18181b;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 36rpx 40rpx;
  box-sizing: border-box;
  margin: 0;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.3);
}

.hud-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.hud-tag {
  font-family: monospace;
  font-size: 20rpx;
  color: #f97316;
  font-weight: 700;
  background: rgba(249, 115, 22, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.hud-status {
  font-size: 20rpx;
  color: #71717a;
}

.card-header {
  margin-bottom: 36rpx;
}

.caption {
  font-size: 20rpx;
  color: #71717a;
  letter-spacing: 2rpx;
}

.speed-counter {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.speed-num {
  font-family: monospace;
  font-size: 88rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: -2rpx;
  line-height: 1;
}

.speed-unit {
  font-size: 28rpx;
  color: #a1a1aa;
  font-weight: 600;
  margin-left: 12rpx;
}

/* 折线图手势滑动区 */
.chart-area {
  position: relative;
  width: 100%;
  height: 160rpx;
  cursor: ew-resize;
}

.polyline-wrapper {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
}

.chart-polyline {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(
    135deg,
    transparent 0%,
    transparent 45%,
    rgba(255, 255, 255, 0.2) 46%,
    transparent 47%
  );
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.15);
}

/* 磁吸游标 */
.scrub-cursor {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: left 0.15s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.cursor-line {
  width: 2rpx;
  height: 100%;
  background: #f97316;
}

.cursor-dot {
  position: absolute;
  top: 40rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #f97316;
  border: 4rpx solid #18181b;
  box-shadow: 0 0 16rpx #f97316;
}
