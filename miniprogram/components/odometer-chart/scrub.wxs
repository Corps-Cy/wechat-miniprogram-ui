var POINTS = [
  { x: 5, val: 38.0 },
  { x: 14, val: 41.2 },
  { x: 23, val: 36.5 },
  { x: 32, val: 46.8 },
  { x: 41, val: 42.1 },
  { x: 50, val: 44.5 },
  { x: 59, val: 58.0 },
  { x: 68, val: 51.3 },
  { x: 77, val: 48.7 },
  { x: 86, val: 52.4 },
  { x: 95, val: 50.1 }
];

function handleScrub(e, ins) {
  var touch = e.touches[0] || e.changedTouches[0];
  if (!touch) return;

  var clientX = touch.clientX;
  var percent = ((clientX - 24) / 320) * 100;
  percent = Math.max(Math.min(percent, 95), 5);

  var closestIdx = 0;
  var minDiff = 999;
  for (var i = 0; i < POINTS.length; i++) {
    var diff = Math.abs(POINTS[i].x - percent);
    if (diff < minDiff) {
      minDiff = diff;
      closestIdx = i;
    }
  }

  var snapPoint = POINTS[closestIdx];
  var cursor = ins.selectComponent('.scrub-cursor');
  if (cursor) {
    cursor.setStyle({
      'left': snapPoint.x + '%',
      'opacity': '1'
    });
  }

  ins.callMethod('onSnap', {
    index: closestIdx + 1,
    value: snapPoint.val.toFixed(1)
  });
}

function touchStart(e, ins) {
  handleScrub(e, ins);
}

function touchMove(e, ins) {
  handleScrub(e, ins);
}

function touchEnd(e, ins) {}

module.exports = {
  touchStart: touchStart,
  touchMove: touchMove,
  touchEnd: touchEnd
};
