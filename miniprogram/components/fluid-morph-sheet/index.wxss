.morph-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx auto;
}

.hud-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #71717a;
  background: #f4f4f5;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

/* 核心流体形变容器 */
.fluid-morph-panel {
  position: relative;
  width: 240rpx;
  height: 80rpx;
  background: #18181b;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.25);
  overflow: hidden;
  transition: width 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
              height 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
              border-radius 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  will-change: width, height, border-radius;
  cursor: pointer;
}

/* 展开态：宽度 620rpx，高度 320rpx，圆角 44rpx */
.fluid-morph-panel.expanded {
  width: 620rpx;
  height: 320rpx;
  border-radius: 44rpx;
}

/* 初态胶囊内容 */
.capsule-content {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  opacity: 1;
  transition: opacity 0.2s ease;
}

.capsule-content.fade-out {
  opacity: 0;
  pointer-events: none;
}

.dot-orange {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #f97316;
}

.capsule-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

.expand-icon {
  font-size: 22rpx;
  color: #71717a;
}

/* 展开态内容 */
.expanded-content {
  position: absolute;
  inset: 0;
  padding: 36rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  opacity: 0;
  transition: opacity 0.3s ease 0.15s;
  pointer-events: none;
}

.expanded-content.fade-in {
  opacity: 1;
  pointer-events: auto;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.badge-fresh {
  font-size: 18rpx;
  font-weight: 700;
  color: #a1a1aa;
  letter-spacing: 2rpx;
}

.big-snow-num {
  display: block;
  font-size: 56rpx;
  font-weight: 900;
  color: #ffffff;
  margin-top: 6rpx;
}

.unit-cm {
  font-size: 24rpx;
  color: #71717a;
  font-weight: 500;
}

.close-morph {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #a1a1aa;
}

.panel-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.loc-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #d4d4d8;
}

.orange-orb {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f97316;
  box-shadow: 0 0 20rpx #f97316;
}
