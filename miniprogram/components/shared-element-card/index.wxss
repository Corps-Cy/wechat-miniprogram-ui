.shared-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 20rpx auto;
}

.hud-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #71717a;
  background: #f4f4f5;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

/* 共享元素卡片 */
.shared-card {
  width: 580rpx;
  height: 380rpx;
  background: #18181b;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.25);
  transition: width 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
              height 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
              transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  display: flex;
  flex-direction: column;
  cursor: pointer;
}

/* 展开态：缩放至 1.09，膨胀至全高度详情页 */
.shared-card.expanded {
  width: 650rpx;
  height: 720rpx;
  transform: scale(1.02);
}

.hero-image-wrap {
  position: relative;
  width: 100%;
  height: 260rpx;
  transition: height 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.shared-card.expanded .hero-image-wrap {
  height: 480rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.back-btn-pill {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-body {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
}

.detail-meta {
  display: block;
  font-size: 20rpx;
  color: #71717a;
  margin-top: 6rpx;
}

.detail-action {
  margin-top: 20rpx;
}

.primary-btn {
  background: #ffffff;
  color: #18181b;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 100rpx;
  padding: 18rpx 0;
  line-height: 1.4;
}

.btn-hover {
  opacity: 0.88;
}
