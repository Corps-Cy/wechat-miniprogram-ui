.ruler-wrapper {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0.45s;
}

.ruler-wrapper.active {
  visibility: visible;
  pointer-events: auto;
}

.ruler-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.ruler-wrapper.active .ruler-mask {
  background: rgba(0, 0, 0, 0.4);
}

.ruler-panel {
  position: relative;
  z-index: 2;
  background: #fbfbf9;
  border-radius: 44rpx 44rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  box-shadow: 0 -16rpx 60rpx rgba(0, 0, 0, 0.15);
  box-sizing: border-box;
}

.ruler-wrapper.active .ruler-panel {
  transform: translateY(0);
}

.close-corner {
  position: absolute;
  top: 36rpx;
  right: 36rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #71717a;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #18181b;
  letter-spacing: 1rpx;
}

.book-id {
  display: block;
  font-size: 20rpx;
  color: #71717a;
  margin-top: 4rpx;
}

.tag-status {
  display: flex;
  align-items: center;
  background: #f4f4f5;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

.dot-amber {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #f59e0b;
  margin-right: 8rpx;
}

.tag-label {
  font-size: 20rpx;
  font-weight: 600;
  color: #3f3f46;
}

/* 核心数字 */
.hero-stat {
  margin: 16rpx 0 24rpx;
}

.days-row {
  display: flex;
  align-items: baseline;
}

.giant-num {
  font-size: 88rpx;
  font-weight: 900;
  color: #18181b;
  letter-spacing: -2rpx;
  line-height: 1;
}

.unit-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #18181b;
  margin-left: 8rpx;
}

.sub-label {
  font-size: 22rpx;
  color: #71717a;
  margin-top: 8rpx;
}

.date-bounds {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #a1a1aa;
  margin-bottom: 12rpx;
}

/* 53 根周刻度尺轴 */
.ruler-container {
  background: #f4f4f5;
  border-radius: 20rpx;
  padding: 44rpx 16rpx 20rpx;
  margin-bottom: 36rpx;
}

.ruler-axis {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 60rpx;
  position: relative;
}

.tick-bar {
  flex: 0 0 4rpx;
  width: 4rpx;
  height: 20rpx;
  background: #e4e4e7;
  border-radius: 2rpx;
  position: relative;
  transition: background 0.25s, height 0.25s;
  transition-delay: var(--stagger-delay);
}

/* 扫过变深：错开 1 帧逐根变深 */
.ruler-wrapper.active .tick-bar.passed {
  background: #71717a;
  height: 32rpx;
}

/* 到今天这一格：强调色（黑色/橙色）并停住 */
.ruler-wrapper.active .tick-bar.today {
  background: #18181b;
  height: 48rpx;
}

.today-badge {
  position: absolute;
  top: -42rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  white-space: nowrap;
}

.today-text {
  background: #18181b;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.today-arrow {
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-top: 5rpx solid #18181b;
}

/* 详情条目 */
.details-table {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  border: 1rpx solid #f4f4f5;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
}

.k-label {
  color: #71717a;
}

.v-val {
  color: #18181b;
  font-weight: 600;
}

/* 原地展开编号，行高固定 */
.code-row {
  padding-top: 6rpx;
  border-top: 1rpx solid #f4f4f5;
}

.code-expand-wrap {
  display: flex;
  align-items: center;
}

.code-text {
  font-family: monospace;
  font-size: 26rpx;
  font-weight: 700;
  color: #18181b;
  letter-spacing: 2rpx;
  line-height: 36rpx;
  height: 36rpx;
  display: inline-block;
  margin-right: 16rpx;
  transition: opacity 0.25s;
}

.reveal-btn {
  background: #f4f4f5;
  color: #3f3f46;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

/* 底部双按钮 */
.action-row {
  display: flex;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  background: #f4f4f5;
  color: #18181b;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 100rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  margin: 0;
}

.btn-primary {
  flex: 1;
  background: #18181b;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 100rpx;
  padding: 22rpx 0;
  line-height: 1.4;
  margin: 0;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}
