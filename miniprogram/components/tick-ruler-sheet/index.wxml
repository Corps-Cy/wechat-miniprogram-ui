<view class="ruler-wrapper {{visible ? 'active' : ''}}" wx:if="{{rendered}}">
  <view class="ruler-mask" catchtouchmove="preventTouchMove" bindtap="handleClose"></view>

  <view class="ruler-panel" catchtouchmove="preventTouchMove">
    <!-- 顶部标题与关闭区 -->
    <view class="panel-header">
      <view class="brand-line">
        <text class="brand-name">ROAM</text>
        <text class="book-id">手册编号 N° 0417</text>
      </view>
      <view class="header-right">
        <view class="tag-status">
          <text class="dot-amber"></text>
          <text class="tag-label">记录中 · 年轻就要去</text>
        </view>
        <view class="close-corner" hover-class="btn-hover" bindtap="handleClose">✕</view>
      </view>
    </view>

    <!-- 剩余天数大字 -->
    <view class="hero-stat">
      <view class="days-row">
        <text class="giant-num">{{displayDays}}</text>
        <text class="unit-text">天</text>
      </view>
      <text class="sub-label">剩余天数</text>
    </view>

    <!-- 日期起止区间 -->
    <view class="date-bounds">
      <text>2026.03.10</text>
      <text>2027.03.10</text>
    </view>

    <!-- 53 根周刻度尺轴 -->
    <view class="ruler-container">
      <view class="ruler-axis">
        <block wx:for="{{ticks}}" wx:key="index">
          <view 
            class="tick-bar {{item.isPassed ? 'passed' : ''}} {{item.isToday ? 'today' : ''}}"
            style="--stagger-delay: {{index * 16}}ms;"
          >
            <view wx:if="{{item.isToday}}" class="today-badge">
              <text class="today-text">今天</text>
              <view class="today-arrow"></view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- 详情条目表格 -->
    <view class="details-table">
      <view class="detail-row">
        <text class="k-label">有效期至</text>
        <text class="v-val">2027年3月10日</text>
      </view>
      <view class="detail-row">
        <text class="k-label">上一站</text>
        <text class="v-val">布拉格茶城</text>
      </view>
      <view class="detail-row">
        <text class="k-label">已记</text>
        <text class="v-val">5 条图文</text>
      </view>

      <!-- 手账编号：原地展开 -->
      <view class="detail-row code-row">
        <text class="k-label">手账编号</text>
        <view class="code-expand-wrap">
          <text class="code-text {{revealed ? 'revealed' : ''}}">{{revealed ? fullCode : maskedCode}}</text>
          <view class="reveal-btn" hover-class="btn-hover" bindtap="handleToggleReveal">
            {{revealed ? '隐藏' : '显示'}}
          </view>
        </view>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="action-row">
      <button class="btn-secondary" hover-class="btn-hover" bindtap="handleRefresh">继续刷新</button>
      <button class="btn-primary" hover-class="btn-hover" bindtap="handleWrite">写一篇</button>
    </view>
  </view>
</view>
