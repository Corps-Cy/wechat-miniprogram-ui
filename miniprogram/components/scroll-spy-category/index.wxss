.spy-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
  box-sizing: border-box;
}

.hud-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hud-pill {
  font-family: monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #38bdf8;
  background: rgba(56, 189, 248, 0.12);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.spy-card {
  width: 100%;
  height: 600rpx;
  background: #18181b;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
}

.card-head {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.head-k {
  font-size: 18rpx;
  color: #71717a;
  letter-spacing: 2rpx;
  font-weight: 700;
}

.head-v {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.spy-body {
  flex: 1;
  display: flex;
  gap: 20rpx;
  overflow: hidden;
}

/* 左侧栏 */
.sidebar-col {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border-right: 1rpx solid rgba(255, 255, 255, 0.08);
  padding-right: 12rpx;
}

.cat-item {
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  transition: background 0.2s, color 0.2s;
  cursor: pointer;
}

.cat-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #71717a;
}

.cat-item.active-cat {
  background: #27272a;
}

.cat-item.active-cat .cat-label {
  color: #ffffff;
  font-weight: 800;
}

/* 右侧滚动列表 */
.menu-scroll {
  flex: 1;
  height: 100%;
}

.section-group {
  margin-bottom: 28rpx;
}

.group-title {
  display: block;
  font-size: 20rpx;
  font-weight: 800;
  color: #38bdf8;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.items-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dish-item {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dish-hover {
  background: rgba(255, 255, 255, 0.08);
}

.dish-name {
  font-size: 24rpx;
  color: #e4e4e7;
  font-weight: 500;
}

.dish-price {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
}
