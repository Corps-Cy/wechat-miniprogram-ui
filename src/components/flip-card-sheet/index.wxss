.flip-wrapper {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0.4s;
}

.flip-wrapper.active {
  visibility: visible;
  pointer-events: auto;
}

.flip-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0);
  transition: background 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.flip-wrapper.active .flip-mask {
  background: rgba(15, 23, 42, 0.65);
}

.flip-dialog {
  position: relative;
  z-index: 2;
  width: 650rpx;
  transform: scale(0.92);
  opacity: 0;
  transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
              opacity 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
}

.flip-wrapper.active .flip-dialog {
  transform: scale(1);
  opacity: 1;
}

/* 3D 舞台：perspective: 1200px */
.flip-stage {
  perspective: 1200px;
  width: 100%;
}

.flip-card {
  position: relative;
  width: 100%;
  height: 820rpx;
  transform-style: preserve-3d;
  transition: transform 0.65s cubic-bezier(0.2, 0.7, 0.2, 1);
  will-change: transform;
}

/* 环绕 Y 轴翻转 180 度 */
.flip-card.is-flipped {
  transform: rotateY(180deg);
}

/* 正反卡面通用属性 */
.card-face {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: 36rpx;
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.2);
}

/* 正面样式 */
.card-front {
  background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
  border: 1rpx solid #e2e8f0;
  transform: rotateY(0deg);
}

/* 背面样式：初始 rotateY(180deg) 藏于背后 */
.card-back {
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  transform: rotateY(180deg);
}

.face-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #3b82f6;
  background: #eff6ff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag-back {
  color: #ef4444;
  background: #fef2f2;
}

.flip-trigger-btn {
  padding: 8rpx 16rpx;
}

.trigger-text {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.face-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.3;
}

.card-desc {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 14rpx;
  line-height: 1.5;
}

.validity-box {
  margin-top: 40rpx;
  background: #f1f5f9;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
}

.valid-label {
  font-size: 24rpx;
  color: #64748b;
}

.valid-val {
  font-size: 24rpx;
  font-weight: 600;
  color: #1e293b;
}

/* 背面核销二维码区 */
.qr-body {
  align-items: center;
}

.barcode-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.barcode-lines {
  width: 400rpx;
  height: 70rpx;
  background: repeating-linear-gradient(
    90deg,
    #0f172a 0px,
    #0f172a 3px,
    transparent 3px,
    transparent 6px,
    #0f172a 6px,
    #0f172a 10px,
    transparent 10px,
    transparent 13px
  );
  border-radius: 4rpx;
}

.barcode-num {
  font-family: monospace;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #334155;
  margin-top: 8rpx;
}

.qrcode-wrapper {
  width: 280rpx;
  height: 280rpx;
  padding: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.qrcode-img {
  width: 100%;
  height: 100%;
}

.qr-hint {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 16rpx;
}

/* 按钮 */
.flip-main-btn {
  background: #3b82f6;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 100rpx;
  padding: 22rpx 0;
  line-height: 1.4;
}

.back-close-btn {
  background: #f1f5f9;
  color: #334155;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 100rpx;
  padding: 22rpx 0;
  line-height: 1.4;
}
